{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "대한민국 1960 콘텐츠(data/game.json) 스키마 — 데이터 2.0.0",
  "type": "object",
  "required": [
    "meta",
    "metrics",
    "goods",
    "buildings",
    "lawGroups",
    "laws",
    "interestGroups",
    "economy",
    "traits",
    "regions",
    "countries",
    "policies",
    "edicts",
    "advisers",
    "events",
    "endings",
    "balance",
    "achievements",
    "sources"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "version",
        "schemaVersion",
        "turns"
      ],
      "properties": {
        "id": {
          "const": "korea1960"
        },
        "schemaVersion": {
          "const": 1
        },
        "turns": {
          "const": 240
        },
        "version": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          }
        }
      }
    },
    "goods": {
      "type": "array",
      "minItems": 1,
      "description": "2.0.0: 시장에서 사고파는 상품. 판매 주문과 구매 주문의 수급이 가격을 정한다.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "price",
          "need",
          "world",
          "mark",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "enum": [
              "staple",
              "industrial",
              "luxury",
              "military"
            ]
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "기준가격"
          },
          "need": {
            "type": "object",
            "required": [
              "q0",
              "e"
            ],
            "properties": {
              "q0": {
                "type": "number",
                "minimum": 0,
                "description": "1960년 1월 가계 소비 구성의 기준량"
              },
              "e": {
                "type": "number",
                "minimum": 0,
                "description": "소득 탄력성"
              }
            }
          },
          "world": {
            "type": [
              "object",
              "null"
            ],
            "description": "null이면 교역하지 않는 상품",
            "properties": {
              "price": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "세계 가격 = 기준가격 × 이 값"
              },
              "export": {
                "type": "number",
                "minimum": 0,
                "description": "1960년의 월 수출 한도"
              },
              "import": {
                "type": "boolean"
              },
              "noTariff": {
                "type": "boolean"
              },
              "schedule": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2
                },
                "description": "[시작 턴, 세계 가격 배율]"
              }
            }
          },
          "mark": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "buildings": {
      "type": "array",
      "minItems": 1,
      "description": "2.0.0: 단계형 건물. 수량은 한 단계·한 달 기준.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "cost",
          "infraUse",
          "owner",
          "unlockYear",
          "description",
          "pm"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "enum": [
              "agri",
              "resource",
              "manufacturing",
              "infrastructure",
              "service",
              "government",
              "military"
            ]
          },
          "cost": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "한 단계에 드는 건설점"
          },
          "infraUse": {
            "type": "number",
            "minimum": 0
          },
          "infraSupply": {
            "type": "number",
            "minimum": 0
          },
          "trade": {
            "type": "number",
            "minimum": 0,
            "description": "무역 역량(값 단위)"
          },
          "owner": {
            "enum": [
              "business",
              "land",
              "petite",
              "state"
            ]
          },
          "tech": {
            "enum": [
              "industry",
              "agriculture",
              "infrastructure"
            ]
          },
          "skill": {
            "type": "number",
            "description": "교육 지수가 이 값보다 낮으면 효율이 떨어진다"
          },
          "development": {
            "type": "number",
            "minimum": 0
          },
          "requires": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_]+$"
            }
          },
          "maxPerRegion": {
            "type": "integer",
            "minimum": 1
          },
          "cap": {
            "enum": [
              "arable"
            ]
          },
          "unlockYear": {
            "type": "integer"
          },
          "pollution": {
            "type": "number"
          },
          "private": {
            "type": "boolean",
            "description": "false이면 민간이 짓거나 가질 수 없다"
          },
          "gov": {
            "type": "boolean",
            "description": "시장에 팔지 않는 정부 건물(인건비·물자를 국고가 낸다)"
          },
          "construction": {
            "type": "boolean"
          },
          "monthlyEffects": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "description": {
            "type": "string"
          },
          "pm": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "jobs",
                "in",
                "out"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_]+$"
                },
                "name": {
                  "type": "string"
                },
                "jobs": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "in": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "out": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "unlock": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "year": {
                      "type": "integer"
                    },
                    "metric": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "number"
                      }
                    }
                  }
                },
                "points": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "건설 부문: 단계마다 만드는 건설점"
                },
                "materials": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "pollution": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "lawGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "column",
          "interval",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "column": {
            "enum": [
              "power",
              "economy",
              "rights"
            ]
          },
          "interval": {
            "type": "integer",
            "minimum": 1,
            "description": "제정 검사 간격(개월)"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "laws": {
      "type": "array",
      "minItems": 1,
      "description": "2.0.0: 분류마다 하나만 유효한 법률. initial이 1960년의 현행 법.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "group",
          "name",
          "unlockYear",
          "cost",
          "monthlyCost",
          "effects",
          "monthlyEffects",
          "modifiers",
          "stances",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "group": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "unlockYear": {
            "type": "integer"
          },
          "initial": {
            "type": "boolean"
          },
          "cost": {
            "type": "number",
            "minimum": 0
          },
          "monthlyCost": {
            "type": "number",
            "minimum": 0
          },
          "effects": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "monthlyEffects": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "modifiers": {
            "type": "object",
            "description": "경제 보정. 키 목록은 game/economy.mjs의 MODIFIER_KEYS."
          },
          "stances": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                -2,
                -1,
                1,
                2
              ]
            },
            "description": "이해집단의 태도"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "interestGroups": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "description": "2.0.0: 이해집단이자 인구 계층. 순서와 ID는 workers, farmers, petite, business, landowners, military.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "mark",
          "cloutWeight",
          "wage",
          "invest",
          "description",
          "demands",
          "traits"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "mark": {
            "type": "string"
          },
          "cloutWeight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "wage": {
            "type": "number",
            "minimum": 0,
            "description": "평균 임금에 곱하는 값(0이면 임금 없이 배당으로 산다)"
          },
          "invest": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "배당 가운데 투자기금에 내는 비율"
          },
          "description": {
            "type": "string"
          },
          "demands": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "text",
                "buildings",
                "base",
                "perYear",
                "from",
                "weight"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_]+$"
                },
                "text": {
                  "type": "string"
                },
                "buildings": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_]+$"
                  }
                },
                "base": {
                  "type": "number"
                },
                "perYear": {
                  "type": "number"
                },
                "from": {
                  "type": "number"
                },
                "weight": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "traits": {
            "type": "object",
            "required": [
              "unhappy",
              "happy",
              "loyal"
            ],
            "additionalProperties": false,
            "properties": {
              "unhappy": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "modifiers": {
                    "type": "object"
                  },
                  "monthly": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number"
                    }
                  }
                }
              },
              "happy": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "modifiers": {
                    "type": "object"
                  },
                  "monthly": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number"
                    }
                  }
                }
              },
              "loyal": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "modifiers": {
                    "type": "object"
                  },
                  "monthly": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "economy": {
      "type": "object",
      "description": "2.0.0: 시장 모형의 상수. 설명은 docs/SIMULATION_RULES.md '시장 경제'.",
      "required": [
        "unit",
        "workforce",
        "wage",
        "price",
        "saving",
        "subsistence",
        "approval",
        "government",
        "enactment",
        "depreciation",
        "budgetDemand"
      ]
    },
    "traits": {
      "type": "array",
      "minItems": 1,
      "description": "1.3.0: 권역의 지형(terrain)·자원(resource). 고유 사업과 지역 시책의 조건.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "mark",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "kind": {
            "enum": [
              "terrain",
              "resource"
            ]
          },
          "name": {
            "type": "string"
          },
          "mark": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "resources",
          "terrain",
          "arable",
          "start"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "terrain": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_]+$"
            }
          },
          "resources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_]+$"
            }
          },
          "arable": {
            "type": "integer",
            "minimum": 1,
            "description": "농장 단계 한도"
          },
          "start": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1
            },
            "description": "1960년의 건물과 단계"
          }
        }
      }
    },
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          }
        }
      }
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "cost",
          "monthlyCost",
          "unlockYear",
          "effects",
          "monthlyEffects",
          "factionEffects"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "cost": {
            "type": "number",
            "minimum": 0
          },
          "monthlyCost": {
            "type": "number",
            "minimum": 0
          },
          "unlockYear": {
            "type": "integer",
            "minimum": 1960,
            "maximum": 1979
          }
        }
      }
    },
    "edicts": {
      "type": "array",
      "minItems": 1,
      "description": "지역 시책. 권역마다 하나, 동시에 2+floor(행정 역량/30)개까지(법률로 +1).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "requires",
          "cost",
          "monthlyCost",
          "unlockYear",
          "monthlyEffects",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_]+$"
            },
            "description": "권역 지형·자원 중 하나라도 있으면 된다. 빈 배열이면 어느 권역이나."
          },
          "maxDevelopment": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 100
          },
          "cost": {
            "type": "number",
            "minimum": 0
          },
          "monthlyCost": {
            "type": "number",
            "minimum": 0
          },
          "unlockYear": {
            "type": "integer",
            "minimum": 1960,
            "maximum": 1979
          },
          "monthlyEffects": {
            "type": "object"
          },
          "factionEffects": {
            "type": "object"
          },
          "description": {
            "type": "string"
          },
          "constructionBonus": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 0.5,
            "description": "이 권역의 공사 진행을 이 비율만큼 빠르게 한다"
          }
        }
      }
    },
    "advisers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "body",
          "choices",
          "kind",
          "art",
          "sourceIds",
          "conditions",
          "cooldown"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "historical_anchor",
              "fictional_system"
            ]
          },
          "art": {
            "enum": [
              "cover",
              "cabinet",
              "industry",
              "civic"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^19[67][0-9]-(0[1-9]|1[0-2])$"
          },
          "cooldown": {
            "type": "integer",
            "minimum": 0
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "phaseIn": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "prelude",
                      "civilian",
                      "transition",
                      "elected",
                      "governing"
                    ]
                  }
                },
                "flag": {
                  "enum": [
                    "route",
                    "won1963",
                    "constitutionalLimit",
                    "authoritarian"
                  ]
                },
                "eq": {
                  "type": [
                    "boolean",
                    "string"
                  ]
                },
                "yearGte": {
                  "type": "integer"
                },
                "yearLte": {
                  "type": "integer"
                },
                "metric": {
                  "type": "string"
                },
                "gte": {
                  "type": "number"
                },
                "lte": {
                  "type": "number"
                }
              }
            }
          },
          "choices": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "effects"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
