{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KOREA1960 content contract",
  "type": "object",
  "required": [
    "meta",
    "metrics",
    "factions",
    "regions",
    "countries",
    "policies",
    "projects",
    "advisers",
    "events",
    "endings",
    "achievements",
    "sources"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "version",
        "schemaVersion",
        "turns"
      ],
      "properties": {
        "id": {
          "const": "korea1960"
        },
        "schemaVersion": {
          "const": 1
        },
        "turns": {
          "const": 240
        },
        "version": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          }
        }
      }
    },
    "factions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          }
        }
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          }
        }
      }
    },
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          }
        }
      }
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "cost",
          "monthlyCost",
          "unlockYear",
          "effects",
          "monthlyEffects",
          "factionEffects",
          "requiresBill"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "cost": {
            "type": "number",
            "minimum": 0
          },
          "monthlyCost": {
            "type": "number",
            "minimum": 0
          },
          "unlockYear": {
            "type": "integer",
            "minimum": 1960,
            "maximum": 1979
          },
          "requiresBill": {
            "type": "boolean"
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "cost",
          "months",
          "maintenance",
          "income",
          "effects",
          "unlockYear"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "cost": {
            "type": "number",
            "minimum": 0
          },
          "months": {
            "type": "integer",
            "minimum": 1
          },
          "maintenance": {
            "type": "number",
            "minimum": 0
          },
          "income": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "advisers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "body",
          "choices",
          "kind",
          "art",
          "sourceIds",
          "conditions",
          "cooldown"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "historical_anchor",
              "fictional_system"
            ]
          },
          "art": {
            "enum": [
              "cover",
              "cabinet",
              "industry",
              "civic"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^19[67][0-9]-(0[1-9]|1[0-2])$"
          },
          "cooldown": {
            "type": "integer",
            "minimum": 0
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "choices": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "effects"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "effects": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    },
    "endings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          }
        }
      }
    },
    "achievements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          }
        }
      }
    }
  }
}
