{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KOREA1960 content contract",
  "type": "object",
  "required": [
    "meta",
    "metrics",
    "factions",
    "traits",
    "regions",
    "countries",
    "policies",
    "projects",
    "edicts",
    "advisers",
    "events",
    "endings",
    "achievements",
    "sources"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "version",
        "schemaVersion",
        "turns"
      ],
      "properties": {
        "id": {
          "const": "korea1960"
        },
        "schemaVersion": {
          "const": 1
        },
        "turns": {
          "const": 240
        },
        "version": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          }
        }
      }
    },
    "factions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          }
        }
      }
    },
    "traits": {
      "type": "array",
      "minItems": 1,
      "description": "1.3.0: 권역의 지형(terrain)·자원(resource). 고유 사업과 지역 시책의 조건.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "mark",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "kind": {
            "enum": [
              "terrain",
              "resource"
            ]
          },
          "name": {
            "type": "string"
          },
          "mark": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "resources",
          "terrain"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "terrain": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_]+$"
            }
          },
          "resources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_]+$"
            }
          }
        }
      }
    },
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          }
        }
      }
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "cost",
          "monthlyCost",
          "unlockYear",
          "effects",
          "monthlyEffects",
          "factionEffects",
          "requiresBill"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "cost": {
            "type": "number",
            "minimum": 0
          },
          "monthlyCost": {
            "type": "number",
            "minimum": 0
          },
          "unlockYear": {
            "type": "integer",
            "minimum": 1960,
            "maximum": 1979
          },
          "requiresBill": {
            "type": "boolean"
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "cost",
          "months",
          "maintenance",
          "income",
          "effects",
          "unlockYear"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "cost": {
            "type": "number",
            "minimum": 0
          },
          "months": {
            "type": "integer",
            "minimum": 1
          },
          "maintenance": {
            "type": "number",
            "minimum": 0
          },
          "income": {
            "type": "number",
            "minimum": 0
          },
          "requires": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_]+$"
            },
            "description": "1.3.0: 고유 사업. 권역에 이 지형·자원 중 하나가 있어야 착수할 수 있다."
          },
          "development": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30,
            "description": "준공 시 권역 개발도 증가. 없으면 9."
          }
        }
      }
    },
    "edicts": {
      "type": "array",
      "minItems": 1,
      "description": "1.3.0: 지역 시책. 권역마다 하나, 동시에 2+floor(행정 역량/30)개까지.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "requires",
          "cost",
          "monthlyCost",
          "unlockYear",
          "monthlyEffects",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_]+$"
            },
            "description": "권역 지형·자원 중 하나라도 있으면 된다. 빈 배열이면 어느 권역이나."
          },
          "maxDevelopment": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 100
          },
          "cost": {
            "type": "number",
            "minimum": 0
          },
          "monthlyCost": {
            "type": "number",
            "minimum": 0
          },
          "unlockYear": {
            "type": "integer",
            "minimum": 1960,
            "maximum": 1979
          },
          "monthlyEffects": {
            "type": "object"
          },
          "factionEffects": {
            "type": "object"
          },
          "buildDiscount": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 0.5
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "advisers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "body",
          "choices",
          "kind",
          "art",
          "sourceIds",
          "conditions",
          "cooldown"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "historical_anchor",
              "fictional_system"
            ]
          },
          "art": {
            "enum": [
              "cover",
              "cabinet",
              "industry",
              "civic"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^19[67][0-9]-(0[1-9]|1[0-2])$"
          },
          "cooldown": {
            "type": "integer",
            "minimum": 0
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "phaseIn": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "prelude",
                      "civilian",
                      "transition",
                      "elected",
                      "governing"
                    ]
                  }
                },
                "flag": {
                  "enum": [
                    "route",
                    "won1963",
                    "constitutionalLimit",
                    "authoritarian"
                  ]
                },
                "eq": {
                  "type": [
                    "boolean",
                    "string"
                  ]
                },
                "yearGte": {
                  "type": "integer"
                },
                "yearLte": {
                  "type": "integer"
                },
                "metric": {
                  "type": "string"
                },
                "gte": {
                  "type": "number"
                },
                "lte": {
                  "type": "number"
                }
              }
            }
          },
          "choices": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "effects"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "effects": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "context": {
            "type": "array",
            "minItems": 1,
            "description": "v1.1.0: 현재 경로에 맞는 '이 캠페인에서는' 설명. 조건이 맞는 첫 항목을 표시한다. 실제 역사 문장(body)과 분리한다.",
            "items": {
              "type": "object",
              "required": [
                "conditions",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "conditions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "minProperties": 1,
                    "properties": {
                      "phaseIn": {
                        "type": "array",
                        "items": {
                          "enum": [
                            "prelude",
                            "civilian",
                            "transition",
                            "elected",
                            "governing"
                          ]
                        }
                      },
                      "flag": {
                        "enum": [
                          "route",
                          "won1963",
                          "constitutionalLimit",
                          "authoritarian"
                        ]
                      },
                      "eq": {
                        "type": [
                          "boolean",
                          "string"
                        ]
                      },
                      "yearGte": {
                        "type": "integer"
                      },
                      "yearLte": {
                        "type": "integer"
                      },
                      "metric": {
                        "type": "string"
                      },
                      "gte": {
                        "type": "number"
                      },
                      "lte": {
                        "type": "number"
                      }
                    }
                  }
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                }
              }
            }
          }
        }
      }
    },
    "endings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          }
        }
      }
    },
    "achievements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+$"
          }
        }
      }
    },
    "balance": {
      "description": "데이터 1.2.0 밸런스 규칙(선택). 없으면 엔진은 1.1.0 계산을 쓴다. 세부 검사는 tools/validate_content.py.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string"
        },
        "growthNote": {
          "type": "string"
        },
        "diminishing": {
          "type": "object",
          "required": [
            "metrics",
            "from",
            "minFactor"
          ],
          "additionalProperties": false,
          "properties": {
            "note": {
              "type": "string"
            },
            "metrics": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "from": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 100
            },
            "minFactor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "eventGain": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "note": {
              "type": "string"
            },
            "fictional_system": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "historical_anchor": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            }
          }
        },
        "expectations": {
          "type": "object",
          "properties": {
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "target",
              "rate"
            ],
            "additionalProperties": false,
            "properties": {
              "target": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "rate": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.2
              }
            }
          }
        },
        "growthBase": {
          "type": "number",
          "minimum": -0.01,
          "maximum": 0.012
        },
        "militaryRule": {
          "type": "object",
          "required": [
            "monthly"
          ],
          "additionalProperties": false,
          "properties": {
            "note": {
              "type": "string"
            },
            "monthly": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          }
        },
        "authoritarian": {
          "type": "object",
          "required": [
            "monthly"
          ],
          "additionalProperties": false,
          "properties": {
            "note": {
              "type": "string"
            },
            "monthly": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            "gainFactor": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            "support": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            },
            "relations": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
